# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string. Used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Server ---
NODE_ENV=development
PORT=4000
# The URL of the Next.js app (used for CORS). In production: https://your-web.vercel.app
CLIENT_ORIGIN="http://localhost:3000"

# --- Seeding the first admin (used by `npm run db:seed`) ---
ADMIN_EMAIL="admin@learnhub.test"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Platform Admin"
