// LearnHub database schema.
// Run `npm run db:migrate` after editing to create a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  LEARNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(LEARNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
}

// One row per issued refresh token. Tokens are stored hashed (SHA-256), never raw.
// `familyId` groups a chain of rotated tokens so a reused token can revoke the whole chain.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String
  thumbnailUrl String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([category])
  @@index([published])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  description     String
  videoUrl        String
  durationSeconds Int
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  // A lesson's order inside a course is unique and enforced by the database.
  @@unique([courseId, position])
  @@index([courseId])
}

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  enrolledAt     DateTime  @default(now())
  lastAccessedAt DateTime  @default(now())
  completedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // A learner can enroll in a course only once.
  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  positionSeconds Int       @default(0)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // One progress row per learner per lesson.
  @@unique([userId, lessonId])
  @@index([lessonId])
}
